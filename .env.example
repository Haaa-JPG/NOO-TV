# ============================================================
# NOO TV Environment Variables
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (direct connection for worker/cron)
DATABASE_URL=postgresql://postgres:password@host:6543/postgres

# Server
PORT=3000
NODE_ENV=production

# Worker & Cron
ENABLE_WORKER=true
ENABLE_CRON=true
WORKER_CONCURRENCY=1
STREAM_REFRESH_WINDOW_SECONDS=1800

# Streaming API (SERVER-SIDE ONLY - never use NEXT_PUBLIC_ prefix)
STREAMING_API_URL=https://your-streaming-api.com
STREAMING_API_KEY=your-api-key

# CORS
ALLOWED_ORIGINS=https://your-domain.com
